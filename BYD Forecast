SELECT 
  ANIOMES_ESTR,
  CASE 
    WHEN CTA_NIV_MOR IN (0, 1) THEN '0-1' 
    ELSE CAST(CTA_NIV_MOR AS STRING) 
  END AS CTA_NIV_MOR, 
  COUNT(CTA_CVE) AS CNTAS, 
  SUM(CTA_SDO_aCT) AS SDO
FROM `crp-pro-cx-semantica.mus_pro_negfin_shared_views.VFAC_NEGFIN_BYD_TM`
WHERE 
  FLG_ACTIVA = 1 
  AND FLG_LIQ = 1 
  AND ANIO_OBS = 2026 
  AND MES_OBS = 10
GROUP BY 1, 2
ORDER BY 2

