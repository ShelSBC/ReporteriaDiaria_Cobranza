SELECT
CASE
  WHEN CTA_NIV_MOR IN (0, 1) THEN '0-1'
ELSE CAST (CTA_NIV_MOR AS STRING) END CTA_NIV_MOR, 
    COUNT (DISTINCT S.CTA_CVE) AS TOTAL_CUENTAS, 
    SUM (S.CTA_SD0_ACT) AS TOTAL_SALDO
FROM `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_SDO_CTA_MES` S
LEFT JOIN `crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_SDO_PLAN` P
ON S.CTA_CVE = P.CTA_CVE
WHERE S.CCR_CVE_BLQ_DOS = 'T'
  AND S.LOG_CVE = 200
  AND S.TIP_INF = 110
  AND S.CTA_FCH_SOL >= '2026-05-01'
  AND S.MES = 09
  AND S.ANIO = 2026
  AND P.PLAN_CVE IN (89503, 89506, 89509, 89512, 89518, 89524, 89536, 79912)
  AND P. PLAN_SDO_ACT > 0
GROUP BY ALL
